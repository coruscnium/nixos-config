# quadcast2s - RGB lighting for the HyperX QuadCast 2 S
# SPDX-License-Identifier: AGPL-3.0-only
#
# Started by udev when the microphone appears, via SYSTEMD_USER_WANTS in
# 70-quadcast2s.rules. It does nothing unless the user has opted in, which is
# what the ConditionPathExists is for -- a plain file in the user's own config
# directory, so the GUI can toggle it without needing root to edit udev rules.

[Unit]
Description=Start QuadCast 2 S lighting when the microphone is connected
ConditionPathExists=%h/.config/quadcast2s/start-on-connect

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --user start quadcast2s.service
